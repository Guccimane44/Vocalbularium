{
  "manifest_version": 3,
  "name": "Vocabularium",
  "version": "0.1.0",
  "description": "Save selected words to your vocabulary library.",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Vocabularium"
  }
}