{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "src/core/store-records.ts",
    "src/core/store.mjs",
    "src/server/routes.mjs",
    "src/server/generation.mjs",
    "types/editor-drafts.ts",
    "types/chrome.d.ts",
    "types/fastify.ts",
    "types/extension.ts",
    "extension/background-runtime.js",
    "extension/recovery.js",
    "extension/pages.js",
    "extension/app.js",
    "extension/dialog.ts",
    "extension/sorting.ts",
    "extension/dashboard.tsx",
    "extension/configuration.tsx",
    "extension/page-view.tsx",
    "src/persistence/**/*.ts",
    "drizzle.config.ts"
  ]
}
