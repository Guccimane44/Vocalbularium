{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "src/core/store-records.ts",
    "types/editor-drafts.ts",
    "types/chrome.d.ts",
    "extension/api-failure.js",
    "extension/save-operations.js",
    "extension/dashboard.tsx",
    "extension/configuration.tsx",
    "src/server/api-failure.mjs",
    "src/server/contract-validation.mjs",
    "src/persistence/**/*.ts",
    "drizzle.config.ts"
  ]
}
