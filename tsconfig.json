{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "shared/**/*.mjs",
    "src/**/*.mjs",
    "extension/**/*.js",
    "scripts/**/*.mjs",
    "tests/helpers/**/*.mjs",
    "packages/contracts/src/**/*.ts",
    "packages/domain/src/**/*.ts",
    "src/core/store-records.ts",
    "types/editor-drafts.ts",
    "types/chrome.d.ts",
    "types/globals.d.ts",
    "types/fastify.ts",
    "types/extension.ts",
    "extension/dialog.ts",
    "extension/sorting.ts",
    "extension/dashboard.tsx",
    "extension/configuration.tsx",
    "extension/page-view.tsx",
    "extension/card-content.tsx",
    "src/persistence/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": ["scripts/golden-set.mjs", "scripts/golden-card.mjs", "scripts/samples.mjs"]
}
