{
  "permissions": {
    "allow": [
      "Bash(git push origin --delete:*)",
      "Bash(git branch -d:*)",
      "Bash(git worktree prune)"
    ],
    "ask": [
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/stop-hook.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
