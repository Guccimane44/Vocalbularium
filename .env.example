HOST=127.0.0.1
PORT=4318
DATA_DIR=.data
LOG_LEVEL=info
DIAGNOSTIC_CONTENT=full
DIAGNOSTIC_BUDGET_BYTES=268435456
GENERATION_MAX_ACTIVE=4
GENERATION_MAX_QUEUED=16
# The generation provider (D11); OpenCode is the only one.
GENERATION_PROVIDER=opencode
# Generation credentials belong only on the server.
# Use the key from your subscribed OpenCode Go workspace at https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Spoken parts' audio (D24): the speech provider, its bounds beside the text
# attempts, and ElevenLabs, one pinned model. ELEVENLABS_VOICES is a JSON map
# of voice IDs: a part's own (module.part, such as german.pronunciation or
# pronunciation.core) comes first, then a language's (de, zh), then the default:
# {"default":"<voice id>","german.pronunciation":"<voice id>","chinese.pronunciation":"<voice id>"}.
SPEECH_PROVIDER=elevenlabs
AUDIO_MAX_ACTIVE=4
AUDIO_MAX_QUEUED=32
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICES=
# Local PostgreSQL 18: npm run db:setup creates ignored .env.postgres with these
# values and separate application, migration, and disposable-test roles.
# DATABASE_URL=postgresql://vocabularium_app:REPLACE_ME@127.0.0.1:5432/vocabularium_dev
# MIGRATION_DATABASE_URL=postgresql://vocabularium_migrator:REPLACE_ME@127.0.0.1:5432/vocabularium_dev
# TEST_DATABASE_ADMIN_URL=postgresql://vocabularium_test:REPLACE_ME@127.0.0.1:5432/postgres
