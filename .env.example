HOST=127.0.0.1
PORT=4318
DATA_DIR=.data
LOG_LEVEL=info
# Generation credentials belong only on the server.
# Use the key from your subscribed OpenCode Go workspace at https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Local PostgreSQL 18: npm run db:setup creates ignored .env.postgres with these
# values and separate application, migration, and disposable-test roles.
# DATABASE_URL=postgresql://vocabularium_app:REPLACE_ME@127.0.0.1:5432/vocabularium_dev
# MIGRATION_DATABASE_URL=postgresql://vocabularium_migrator:REPLACE_ME@127.0.0.1:5432/vocabularium_dev
# TEST_DATABASE_ADMIN_URL=postgresql://vocabularium_test:REPLACE_ME@127.0.0.1:5432/postgres
