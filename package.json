{
  "name": "vocabularium",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/domain"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env.postgres --test tests/diagnostics.test.mjs tests/logging.test.mjs tests/postgres.test.mjs tests/pages-schema.test.mjs tests/foundation.test.mjs tests/server.test.mjs tests/generation.test.mjs tests/components.test.mjs tests/page-modules.test.mjs tests/render.test.mjs tests/contrast.test.mjs tests/decks.test.mjs tests/pages.test.mjs tests/extension.test.mjs tests/reads.test.mjs tests/upgrade.test.mjs",
    "test:browser": "node --env-file-if-exists=.env.postgres --test --test-concurrency=1 tests/app.browser.test.mjs tests/logging.browser.test.mjs",
    "start": "npm run build:packages && node --env-file-if-exists=.env --env-file-if-exists=.env.postgres src/server/start.mjs",
    "logs": "node --env-file-if-exists=.env scripts/logs.mjs",
    "openapi": "npm run build:packages && node scripts/generate-openapi.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "pretest": "npm run build:packages",
    "pretest:browser": "npm run build:packages && node scripts/build.mjs",
    "build": "npm run build:packages && node scripts/build.mjs",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check.mjs && npm run typecheck",
    "smoke:generation": "node --env-file-if-exists=.env scripts/live-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.postgres scripts/migrate.mjs",
    "db:setup": "node scripts/setup-postgres.mjs",
    "db:backup": "node --env-file=.env.postgres scripts/database-backup.mjs backup",
    "db:restore": "node --env-file=.env.postgres scripts/database-backup.mjs restore"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "drizzle-kit": "0.31.11",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fastify/swagger": "9.8.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
