{
  "name": "vocabularium",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/domain"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env.postgres --test tests/postgres.test.mjs tests/foundation.test.mjs tests/server.test.mjs tests/generation.test.mjs tests/decks.test.mjs tests/cards.test.mjs tests/extension.test.mjs",
    "test:browser": "node --env-file-if-exists=.env.postgres --test tests/browser.test.mjs tests/app.browser.test.mjs",
    "start": "npm run build:packages && node --env-file-if-exists=.env --env-file-if-exists=.env.postgres src/server/start.mjs",
    "openapi": "npm run build:packages && node scripts/generate-openapi.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "pretest": "npm run build:packages",
    "pretest:browser": "npm run build:packages && node scripts/build.mjs",
    "build": "npm run build:packages && node scripts/build.mjs",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check.mjs && npm run typecheck",
    "prototype": "node prototypes/server.mjs",
    "smoke:generation": "node --env-file-if-exists=.env scripts/live-smoke.mjs",
    "smoke:hosted": "node scripts/hosted-smoke.mjs",
    "smoke:hosted:browser": "node --test tests/hosted.browser.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.postgres scripts/migrate.mjs",
    "db:setup": "node scripts/setup-postgres.mjs",
    "db:backup": "node --env-file=.env.postgres scripts/database-backup.mjs backup",
    "db:restore": "node --env-file=.env.postgres scripts/database-backup.mjs restore"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
