{
  "name": "vocabularium",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "node --test tests/foundation.test.mjs tests/server.test.mjs tests/generation.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs tests/app.browser.test.mjs",
    "start": "node --env-file-if-exists=.env src/server/start.mjs",
    "build": "node scripts/build.mjs",
    "prototype": "node prototypes/server.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
